#!/usr/bin/env bash
NDK=/opt/android-sdk/ndk/30.0.16248370
LineageOS_16_0='/media/wode/3ae32a44-af73-46a8-9aec-c24e84273ebd/test/lineage-16.0'
LineageOS_17_1='/media/wode/3ae32a44-af73-46a8-9aec-c24e84273ebd/test/lineage-17.1'
LineageOS_18_1='/media/wode/3ae32a44-af73-46a8-9aec-c24e84273ebd/test/lineage-18.1'
arch="$(adb shell uname -m)" || arch=aarch64
av="$(adb shell getprop ro.build.version.sdk)" || av=29
for i in $@;do
	lib="$(echo "$i"|grep -- "^-l")"&&lib="$(echo "$lib"|sed 's/-l//g')" && (test -f  "$NDK/toolchains/llvm/prebuilt/linux-x86_64/sysroot/usr/lib/$arch-linux-android/$av/lib$lib.so"||(cd  "$NDK/toolchains/llvm/prebuilt/linux-x86_64/sysroot/usr/lib/$arch-linux-android" && adb pull "/system/lib64/lib$lib.so" k.so && nm -D k.so|awk '{if($3)print "int "$3";"}' >"$lib.c" && "/home/wode/桌面/bin/$arch-linux-android$av-clang"  "$lib.c" -shared -o "$av/lib$lib.so" && rm k.so "$lib.c"))
done
bin_dir="$NDK/toolchains/llvm/prebuilt/linux-x86_64/bin"
CFLAGS="-D __ndk1=__1  -fno-rtti"
INCLUDE_LIST='external/native_render system/core/base/include frameworks/native/libs/nativebase/include hardware/libhardware/include system/media/audio/include system/core/libcutils/include system/core/libsystem/include system/bt/types frameworks/native/libs/ui/include frameworks/native/libs/arect/include frameworks/native/libs/math/include system/libhidl/base/include system/core/libutils/include system/core/libbacktrace/include system/core/liblog/include system/libhidl/transport/include /media/wode/3ae32a44-af73-46a8-9aec-c24e84273ebd/lineage-16/out/soong/.intermediates/system/libhidl/transport/manager/1.0/android.hidl.manager@1.0_genc++_headers/gen /media/wode/3ae32a44-af73-46a8-9aec-c24e84273ebd/lineage-16/out/soong/.intermediates/system/libhidl/transport/manager/1.1/android.hidl.manager@1.1_genc++_headers/gen /media/wode/3ae32a44-af73-46a8-9aec-c24e84273ebd/lineage-16/out/soong/.intermediates/system/libhidl/transport/base/1.0/android.hidl.base@1.0_genc++_headers/gen system/libhwbinder/include /media/wode/3ae32a44-af73-46a8-9aec-c24e84273ebd/lineage-16/out/soong/.intermediates/hardware/interfaces/graphics/common/1.0/android.hardware.graphics.common@1.0_genc++_headers/gen /media/wode/3ae32a44-af73-46a8-9aec-c24e84273ebd/lineage-16/out/soong/.intermediates/hardware/interfaces/graphics/common/1.1/android.hardware.graphics.common@1.1_genc++_headers/gen frameworks/native/libs/gui/include /media/wode/3ae32a44-af73-46a8-9aec-c24e84273ebd/lineage-16/out/soong/.intermediates/frameworks/native/libs/binder/libbinder/android_arm64_armv8-a_cortex-a73_core_static/gen/aidl frameworks/native/libs/binder/include frameworks/native/opengl/libs/EGL/include frameworks/native/opengl/include frameworks/native/libs/nativewindow/include frameworks/native/libs/nativewindow/include-private system/libhidl/transport/token/1.0/utils/include /media/wode/3ae32a44-af73-46a8-9aec-c24e84273ebd/lineage-16/out/soong/.intermediates/hardware/interfaces/media/1.0/android.hardware.media@1.0_genc++_headers/gen /media/wode/3ae32a44-af73-46a8-9aec-c24e84273ebd/lineage-16/out/soong/.intermediates/hardware/interfaces/graphics/bufferqueue/1.0/android.hardware.graphics.bufferqueue@1.0_genc++_headers/gen frameworks/av/media/ndk/include frameworks/av/camera/include frameworks/av/camera/include/camera system/media/camera/include /media/wode/3ae32a44-af73-46a8-9aec-c24e84273ebd/lineage-16/out/soong/.intermediates/frameworks/av/camera/libcamera_client/android_arm64_armv8-a_cortex-a73_core_shared/gen/aidl external/libcxx/include external/libcxxabi/include bionic/libc/system_properties/include system/core/property_service/libpropertyinfoparser/include system/core/include hardware/libhardware_legacy/include hardware/ril/include libnativehelper/include frameworks/native/include frameworks/av/include libnativehelper/include_jni frameworks/av/camera/ndk/include frameworks/av/media/libaaudio/include bionic/libc/include bionic/libc/kernel/uapi bionic/libc/kernel/uapi/asm-arm64 bionic/libc/kernel/android/scsi bionic/libc/kernel/android/uapi prebuilts/clang/host/linux-x86/clang-4691093/lib64/clang/6.0.2/include out_headers out_headers_dir/hidl out_headers_dir/ndk out_headers_dir/cpp out_headers_dir/proto'
LineageOS=.
test "$av" -eq 30 && LineageOS="$LineageOS_18_1"
test "$av" -eq 29 && LineageOS="$LineageOS_17_1"
test "$av" -eq 28 && LineageOS="$LineageOS_16_0"
test -d frameworks/native && LineageOS=.
for inc in $INCLUDE_LIST;do
	test -d "$LineageOS/$inc" && CPLUS_INCLUDE_PATH="$CPLUS_INCLUDE_PATH:$LineageOS/$inc"
done
export CPLUS_INCLUDE_PATH="$CPLUS_INCLUDE_PATH"
test -f "/media/wode/c1194b4d-35c7-4bc2-b0d8-9ea36982e97f/opt/android-sdk/ndk/30.0.16248370/toolchains/llvm/prebuilt/linux-x86_64/sysroot/usr/lib/$arch-linux-android/$av/libc++.so"||/home/wode/桌面/bin/getc++.sh

if [ "$1" != "-cc1" ]; then
    "$bin_dir/clang" $CFLAGS --target="$arch-linux-android$av" "$@"
else
    # Target is already an argument.
    "$bin_dir/clang" "$@"
fi
