av="$(adb shell getprop ro.build.version.sdk)" ||exit
for i in $@;do
	lib="$(echo "$i"|grep -- "^-l")"&&lib="$(echo "$lib"|sed 's/-l//g')" && (test -f  "$NDK/toolchains/llvm/prebuilt/linux-x86_64/sysroot/usr/lib/$arch-linux-android/$av/lib$lib.so"||(cd  "$NDK/toolchains/llvm/prebuilt/linux-x86_64/sysroot/usr/lib/$arch-linux-android" && adb pull "/system/lib64/lib$lib.so" k.so && nm -D k.so|awk '{if($3)print "int "$3";"}' >"$lib.c" && "/home/wode/桌面/bin/$arch-linux-android$av-clang"  "$lib.c" -shared -o "$av/lib$lib.so" && rm k.so "$lib.c"))
done
bin_dir="/home/wode/桌面/bin"
CFLAGS="-D __ndk1=__1"
test "$av" -eq 30 && export LineageOS="$LineageOS_18_1" && export CPLUS_INCLUDE_PATH=$LineageOS/prebuilts/clang/host/linux-x86/clang-r346389b/include/c++/v1:$LineageOS/frameworks/native/libs/binder/ndk/include_ndk:$LineageOS/external/native_render:$LineageOS/system/core/base/include:$LineageOS/system/core/include:$LineageOS/system/core/libcutils/include:$LineageOS/system/core/libsystem/include:$LineageOS/system/core/libutils/include:$LineageOS/system/core/libbacktrace/include:$LineageOS/system/core/liblog/include:$LineageOS/frameworks/native/libs/nativebase/include:$LineageOS/frameworks/native/libs/ui/include:$LineageOS/frameworks/native/libs/arect/include:$LineageOS/frameworks/native/libs/math/include:$LineageOS/frameworks/native/libs/gui/include:$LineageOS/frameworks/native/libs/binder/include:$LineageOS/frameworks/native/libs/nativewindow/include:$LineageOS/frameworks/native/libs/nativewindow/include-private:$LineageOS/frameworks/native/opengl/libs/EGL/include:$LineageOS/frameworks/native/opengl/include:$LineageOS/frameworks/native/include:$LineageOS/hardware/libhardware/include:$LineageOS/hardware/libhardware_legacy/include:$LineageOS/hardware/ril/include:$LineageOS/system/media/audio/include:$LineageOS/system/media/camera/include:$LineageOS/system/libhidl/base/include:$LineageOS/system/libhidl/transport/include:$LineageOS/system/libhidl/transport/token/1.0/utils/include:$LineageOS/system/libhwbinder/include:$LineageOS/system/bt/types:$LineageOS/libnativehelper/include:$LineageOS/libnativehelper/include_jni:$LineageOS/frameworks/av/media/ndk/include:$LineageOS/frameworks/av/camera/include:$LineageOS/frameworks/av/camera/include/camera:$LineageOS/frameworks/av/camera/ndk/include:$LineageOS/frameworks/av/media/libaaudio/include:$LineageOS/frameworks/av/media/libaudiofoundation/include:$LineageOS/system/core/libprocessgroup/include:$LineageOS/frameworks/av/media/libaudioclient/include:$LineageOS/frameworks/av/media/libmediahelper/include:$LineageOS/frameworks/av/include:$LineageOS/frameworks/av/media/libmediametrics/include:$LineageOS/frameworks/av/media/libmedia/include:$LineageOS/out_headers_dir/hidl:$LineageOS/out_headers_dir/ndk:$LineageOS/out_headers_dir/cpp && CFLAGS="$CFLAGS -fno-rtti"

test "$av" -eq 29 && export LineageOS="$LineageOS_17_1" && export CPLUS_INCLUDE_PATH=$LineageOS/external/native_render:$LineageOS/system/core/base/include:$LineageOS/system/core/include:$LineageOS/system/core/libcutils/include:$LineageOS/system/core/libsystem/include:$LineageOS/system/core/libutils/include:$LineageOS/system/core/libbacktrace/include:$LineageOS/system/core/liblog/include:$LineageOS/frameworks/native/libs/nativebase/include:$LineageOS/frameworks/native/libs/ui/include:$LineageOS/frameworks/native/libs/arect/include:$LineageOS/frameworks/native/libs/math/include:$LineageOS/frameworks/native/libs/gui/include:$LineageOS/frameworks/native/libs/binder/include:$LineageOS/frameworks/native/libs/nativewindow/include:$LineageOS/frameworks/native/libs/nativewindow/include-private:$LineageOS/frameworks/native/opengl/libs/EGL/include:$LineageOS/frameworks/native/opengl/include:$LineageOS/frameworks/native/include:$LineageOS/hardware/libhardware/include:$LineageOS/hardware/libhardware_legacy/include:$LineageOS/hardware/ril/include:$LineageOS/system/media/audio/include:$LineageOS/system/media/camera/include:$LineageOS/system/libhidl/base/include:$LineageOS/system/libhidl/transport/include:$LineageOS/system/libhidl/transport/token/1.0/utils/include:$LineageOS/system/libhwbinder/include:$LineageOS/system/bt/types:$LineageOS/libnativehelper/include:$LineageOS/libnativehelper/include_jni:$LineageOS/frameworks/av/media/ndk/include:$LineageOS/frameworks/av/camera/include:$LineageOS/frameworks/av/camera/include/camera:$LineageOS/frameworks/av/camera/ndk/include:$LineageOS/frameworks/av/media/libaaudio/include:$LineageOS/system/core/libprocessgroup/include:$LineageOS/frameworks/av/include:$LineageOS/out_headers && CFLAGS="$CFLAGS -fno-rtti"
test -f "/media/wode/c1194b4d-35c7-4bc2-b0d8-9ea36982e97f/opt/android-sdk/ndk/30.0.16248370/toolchains/llvm/prebuilt/linux-x86_64/sysroot/usr/lib/$arch-linux-android/$av/libc++.so"||/home/wode/桌面/bin/getc++.sh
if [ "$1" != "-cc1" ]; then
    "$bin_dir/clang" $CFLAGS --target="$arch-linux-android$av" "$@"
else
    # Target is already an argument.
    "$bin_dir/clang" "$@"
